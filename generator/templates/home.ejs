<h1 class="visually-hidden">CSES Problem Set Solutions</h1>

<!-- Compact Header with Stats -->
<header class="compact-header mb-4">
    <div class="row align-items-center">
        <div class="col-lg-6 mb-3 mb-lg-0">
            <p class="compact-subtitle mb-0">Comprehensive solutions and explanations for competitive programming problems</p>
        </div>
        <div class="col-lg-6">
            <div class="stats-compact">
                <div class="progress-overview">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="progress-text">
                            <span class="progress-ratio"><%= stats.totalSolved %>/<%= stats.totalProblems %></span>
                            <span class="progress-label">Problems Solved</span>
                        </div>
                        <div class="progress-percentage"><%= Math.round((stats.totalSolved / stats.totalProblems) * 100) %>%</div>
                    </div>
                    <div class="progress" style="height: 8px; border-radius: 10px;">
                        <div class="progress-bar bg-success" role="progressbar"
                             style="width: <%= (stats.totalSolved / stats.totalProblems) * 100 %>%"
                             aria-valuenow="<%= (stats.totalSolved / stats.totalProblems) * 100 %>"
                             aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
                <div class="stats-mini">
                    <div class="stat-item">
                        <i class="fas fa-folder-open"></i>
                        <span><%= stats.totalTopics %> Topics</span>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-check-circle"></i>
                        <span><%= stats.totalSolved %> Solved</span>
                    </div>
                    <div class="stat-item">
                        <i class="fas fa-code"></i>
                        <span><%= stats.totalProblems %> Total</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<section aria-label="Topics">
    <h2 class="visually-hidden">Problem Topics</h2>
    <div class="row">
        <% topics.forEach(topic => { %>
            <article class="col-xl-4 col-lg-6 col-md-6 mb-4">
                <div class="card topic-card h-100 shadow-sm border-0">
                    <div class="card-body p-4 pb-0">
                        <a href="<%= topic.id %>/index.html" class="text-decoration-none text-dark">
                            <div class="d-flex align-items-center mb-3">
                                <div class="topic-icon me-3" aria-hidden="true">
                                    <i class="fas <%= topic.icon %>"></i>
                                </div>
                                <h3 class="topic-card-title mb-0 flex-grow-1"><%= topic.name %></h3>
                            <% if (topic.progress === 100) { %>
                                <span class="badge bg-success completed-badge">
                                    <i class="fas fa-check"></i>
                                </span>
                            <% } %>
                        </div>
                        <div class="row text-center topic-card-stats mb-4">
                            <div class="col-4">
                                <div class="text-muted small mb-1">Total</div>
                                <div class="fw-bold text-primary"><%= topic.totalProblems %></div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1">Solved</div>
                                <div class="fw-bold text-success"><%= topic.solvedProblems %></div>
                            </div>
                            <div class="col-4">
                                <div class="text-muted small mb-1">Progress</div>
                                <div class="fw-bold <%= topic.progress === 100 ? 'text-success' : topic.progress < 50 ? 'text-warning' : 'text-info' %>"><%= topic.progress %>%</div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="progress topic-card-progress">
                    <div class="progress-bar progress-bar-custom"
                         role="progressbar"
                         style="width: <%= topic.progress %>%"
                         aria-valuenow="<%= topic.progress %>"
                         aria-valuemin="0"
                         aria-valuemax="100">
                    </div>
                    </div>
                </div>
            </article>
        <% }); %>
    </div>
</section>
