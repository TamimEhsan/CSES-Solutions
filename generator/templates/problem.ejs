<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div class="flex-grow-1">
        <h1 class="text-dark "><%= problem.name %></h1>
        <div class="d-flex align-items-center flex-wrap gap-2 mt-3">
            <% problem.tags.forEach(tag => { %>
                <span class="problem-tag-pill">
                    <%= tag %>
                </span>
            <% }); %>
        </div>
    </div>
    <div class="d-flex gap-2 flex-shrink-0">
        <a href="../index.html" class="btn btn-outline-primary">
            <i class="fas fa-arrow-left me-2"></i>Back to <%= topic.name %>
        </a>
        <a href="<%= problem.link %>" target="_blank" class="btn btn-primary cses-original-btn">
            <span class="cses-badge">CSES</span>
            <!-- <span>View Original</span> -->
            <i class="fas fa-external-link-alt ms-1"></i>
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header p-0 bg-white">
        <div class="tab-nav-wrapper position-relative">
            <div class="tab-nav-scroll px-3" id="problemTabsScroll">
                <ul class="nav nav-tabs-custom m-0" id="problemTabs" role="tablist">
                    <% let activeSet = false; %>
                    <% if (content.description) { %>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link-custom <%= !activeSet ? (activeSet = true, 'active') : '' %>" 
                                id="description-tab" 
                                data-bs-toggle="tab" 
                                data-bs-target="#description" 
                                type="button" 
                                role="tab" 
                                aria-controls="description" 
                                aria-selected="<%= !activeSet ? 'true' : 'false' %>">
                            <i class="fas fa-info-circle"></i>
                            <span class="tab-text">Description</span>
                        </button>
                    </li>
                    <% } %>
                    <% if (content.hints) { %>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link-custom <%= !activeSet ? (activeSet = true, 'active') : '' %>" 
                                id="hints-tab" 
                                data-bs-toggle="tab" 
                                data-bs-target="#hints" 
                                type="button" 
                                role="tab" 
                                aria-controls="hints" 
                                aria-selected="<%= !activeSet ? 'true' : 'false' %>">
                            <i class="fas fa-lightbulb"></i>
                            <span class="tab-text">Hints</span>
                        </button>
                    </li>
                    <% } %>
                    <% if (content.solution) { %>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link-custom <%= !activeSet ? (activeSet = true, 'active') : '' %>" 
                                id="solution-tab" 
                                data-bs-toggle="tab" 
                                data-bs-target="#solution" 
                                type="button" 
                                role="tab" 
                                aria-controls="solution" 
                                aria-selected="<%= !activeSet ? 'true' : 'false' %>">
                            <i class="fas fa-check-circle"></i>
                            <span class="tab-text">Solution</span>
                        </button>
                    </li>
                    <% } %>
                    <% if (content.code) { %>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link-custom <%= !activeSet ? (activeSet = true, 'active') : '' %>" 
                                id="code-tab" 
                                data-bs-toggle="tab" 
                                data-bs-target="#code" 
                                type="button" 
                                role="tab" 
                                aria-controls="code" 
                                aria-selected="<%= !activeSet ? 'true' : 'false' %>">
                            <i class="fas fa-code"></i>
                            <span class="tab-text">Code</span>
                            <% if (content.code && Object.keys(content.code).length > 1) { %>
                                <span class="badge bg-primary ms-1 text-white rounded-pill fw-normal" style="font-size: 0.7rem;">
                                    <%= Object.keys(content.code).length %>
                                </span>
                            <% } %>
                        </button>
                    </li>
                    <% } %>
                </ul>
            </div>
            <div class="tab-nav-gradient tab-nav-gradient-left"></div>
            <div class="tab-nav-gradient tab-nav-gradient-right"></div>
        </div>
    </div>
    <div class="card-body">
        <div class="tab-content" id="problemTabContent">
            <% activeSet = false; %>
            <% if (content.description) { %>
            <div class="tab-pane fade <%= !activeSet ? (activeSet = true, 'show active') : '' %>" 
                 id="description" 
                 role="tabpanel" 
                 aria-labelledby="description-tab">
                <div class="lh-lg">
                    <%- content.description %>
                </div>
            </div>
            <% } %>
            <% if (content.hints) { %>
            <div class="tab-pane fade <%= !activeSet ? (activeSet = true, 'show active') : '' %>" 
                 id="hints" 
                 role="tabpanel" 
                 aria-labelledby="hints-tab">
                <div class="lh-lg">
                    <%- content.hints %>
                </div>
            </div>
            <% } %>
            <% if (content.solution) { %>
            <div class="tab-pane fade <%= !activeSet ? (activeSet = true, 'show active') : '' %>" 
                 id="solution" 
                 role="tabpanel" 
                 aria-labelledby="solution-tab">
                <div class="lh-lg">
                    <%- content.solution %>
                </div>
            </div>
            <% } %>
            <% if (content.code) { %>
            <div class="tab-pane fade <%= !activeSet ? (activeSet = true, 'show active') : '' %>"
                 id="code"
                 role="tabpanel"
                 aria-labelledby="code-tab">
                <div class="lh-lg">
                    <h2 class="mb-4">Implementation</h2>

                    <% const codeEntries = Object.entries(content.code); %>
                    <% if (codeEntries.length > 1) { %>
                        <!-- Language selector buttons -->
                        <div class="lang-selector mb-3" role="group">
                            <% codeEntries.forEach(([lang, data], index) => { %>
                                <button type="button"
                                        class="lang-btn <%= index === 0 ? 'active' : '' %>"
                                        onclick="switchLanguage('<%= lang.toLowerCase().replace(/\+/g, 'p').replace(/\s+/g, '-') %>', this)">
                                    <% if (lang.toLowerCase().includes('c++')) { %>
                                        <i class="fas fa-code me-1"></i>
                                    <% } else if (lang.toLowerCase().includes('java')) { %>
                                        <i class="fab fa-java me-1"></i>
                                    <% } else if (lang.toLowerCase().includes('python')) { %>
                                        <i class="fab fa-python me-1"></i>
                                    <% } else { %>
                                        <i class="fas fa-code me-1"></i>
                                    <% } %>
                                    <%= lang %>
                                </button>
                            <% }); %>
                        </div>

                        <!-- Language code blocks -->
                        <% codeEntries.forEach(([lang, data], index) => { %>
                            <div class="lang-content <%= index === 0 ? '' : 'd-none' %>"
                                 id="lang-<%= lang.toLowerCase().replace(/\+/g, 'p').replace(/\s+/g, '-') %>"
                                 data-filename="<%= problem.id %>.<%= data.language === 'cpp' ? 'cpp' : data.language === 'python' ? 'py' : 'java' %>">
                                <div class="d-flex justify-content-end gap-2 mb-2">
                                    <button class="btn btn-sm btn-outline-secondary" onclick="downloadCode(this)">
                                        <i class="fas fa-download me-1"></i>Download
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" onclick="copyCode(this)">
                                        <i class="fas fa-copy me-1"></i>Copy
                                    </button>
                                </div>
                                <pre class="bg-light border rounded p-3 overflow-auto">
                                    <code class="language-<%= data.language %>"><%- data.content %></code>
                                </pre>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <!-- Single language -->
                        <% codeEntries.forEach(([lang, data]) => { %>
                            <div class="mb-4" data-filename="<%= problem.id %>.<%= data.language === 'cpp' ? 'cpp' : data.language === 'python' ? 'py' : 'java' %>">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h4 class="text-dark-emphasis"><%= lang %></h4>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-sm btn-outline-secondary" onclick="downloadCode(this)">
                                            <i class="fas fa-download me-1"></i>Download
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="copyCode(this)">
                                            <i class="fas fa-copy me-1"></i>Copy
                                        </button>
                                    </div>
                                </div>
                                <pre class="bg-light border rounded p-3 overflow-auto">
                                    <code class="language-<%= data.language %>"><%- data.content %></code>
                                </pre>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>
